{
  "template": "contrat_remplacement",
  "description": "Contrat de remplacement en exercice libéral (art. R.4127-65 et R.4127-91 CSP) - champs explicites remplaçant/remplacé",
  "fields": {
    "MEDECIN_REMPLACANT_PRENOM": {
      "type": "string",
      "required": true,
      "description": "Prénom du médecin remplaçant"
    },
    "MEDECIN_REMPLACANT_NOM": {
      "type": "string",
      "required": true,
      "description": "Nom du médecin remplaçant"
    },
    "MEDECIN_REMPLACANT_RPPS": {
      "type": "string",
      "required": true,
      "description": "Numéro RPPS du médecin remplaçant"
    },
    "MEDECIN_REMPLACANT_RRPS": {
      "type": "string",
      "required": false,
      "description": "Alias historique accepté de MEDECIN_REMPLACANT_RPPS"
    },
    "MEDECIN_REMPLACANT_SEXE": {
      "type": "string",
      "required": false,
      "description": "Sexe du médecin remplaçant"
    },
    "MEDECIN_REMPLACANT_THESE": {
      "type": "string",
      "required": false,
      "description": "Statut thésé du médecin remplaçant (oui/non)"
    },
    "MEDECIN_REMPLACANT_ADRESSE": {
      "type": "string",
      "required": false,
      "description": "Adresse du médecin remplaçant"
    },
    "MEDECIN_REMPLACANT_CODE_POSTAL": {
      "type": "string",
      "required": false,
      "description": "Code postal du médecin remplaçant"
    },
    "MEDECIN_REMPLACANT_VILLE": {
      "type": "string",
      "required": false,
      "description": "Ville du médecin remplaçant"
    },
    "MEDECIN_REMPLACE_CABINET_NOM": {
      "type": "string",
      "required": true,
      "description": "Nom du cabinet du médecin remplacé"
    },
    "MEDECIN_REMPLACE_CABINET_ADRESSE": {
      "type": "string",
      "required": true,
      "description": "Adresse du cabinet du médecin remplacé"
    },
    "MEDECIN_REMPMACE_CABINET_ADRESSE": {
      "type": "string",
      "required": false,
      "description": "Alias accepté de MEDECIN_REMPLACE_CABINET_ADRESSE"
    },
    "MEDECIN_REMPLACE_CABINET_CODE_POSTAL": {
      "type": "string",
      "required": true,
      "description": "Code postal du cabinet du médecin remplacé"
    },
    "MEDECIN_REMPMACE_CABINET_CODE_POSTAL": {
      "type": "string",
      "required": false,
      "description": "Alias accepté de MEDECIN_REMPLACE_CABINET_CODE_POSTAL"
    },
    "MEDECIN_REMPLACE_CABINET_VILLE": {
      "type": "string",
      "required": true,
      "description": "Ville du cabinet du médecin remplacé"
    },
    "MEDECIN_REMPMACE_CABINET_VILLE": {
      "type": "string",
      "required": false,
      "description": "Alias accepté de MEDECIN_REMPLACE_CABINET_VILLE"
    },
    "MEDECIN_REMPLACE_NOM": {
      "type": "string",
      "required": true,
      "description": "Nom du médecin remplacé"
    },
    "MEDECIN_REMPLACE_PRENOM": {
      "type": "string",
      "required": true,
      "description": "Prénom du médecin remplacé"
    },
    "MEDECIN_REMPLACE_RPPS": {
      "type": "string",
      "required": true,
      "description": "Numéro RPPS du médecin remplacé"
    },
    "MEDECIN_REMPLACE_RRPS": {
      "type": "string",
      "required": false,
      "description": "Alias historique accepté de MEDECIN_REMPLACE_RPPS"
    },
    "ANNONCE_ID": {
      "type": "string",
      "required": false,
      "description": "Identifiant de l'annonce"
    },
    "CANDIDATURE_ID": {
      "type": "string",
      "required": false,
      "description": "Identifiant de la candidature"
    },
    "CABINET_MEDECIN_ID": {
      "type": "string",
      "required": false,
      "description": "Identifiant cabinet-medecin"
    },
    "CABINET_SIRET": {
      "type": "string",
      "required": false,
      "description": "Numéro SIRET du cabinet"
    },
    "STATUT_CONTRAT_REMPLACEMENT": {
      "type": "string",
      "required": false,
      "description": "Statut du contrat de remplacement"
    },
    "JOURS_REMPLACEMENT": {
      "type": "string",
      "required": true,
      "description": "Nombre de jours calculé à partir des créneaux acceptés (ex: 1,5 jours)"
    },
    "CRENEAUX_ACCEPTES": {
      "type": "array",
      "required": false,
      "description": "Créneaux acceptés affichés en puces, un élément par ligne"
    },
    "DATE_DEBUT_REMPLACEMENT": {
      "type": "string",
      "required": true,
      "description": "Date de début de remplacement (ex: 2026-04-20)"
    },
    "DATE_FIN_REMPLACEMENT": {
      "type": "string",
      "required": true,
      "description": "Date de fin de remplacement (ex: 2026-06-30)"
    },
    "DATE_JOUR": {
      "type": "string",
      "required": false,
      "description": "Date de génération en français ; générée automatiquement si omise"
    },
    "TAUX_RETROCESSION": {
      "type": "string",
      "required": true,
      "description": "Taux de rétrocession des honoraires en % (ex: 70)"
    },
    "DATE_SIGNATURE_CABINET": {
      "type": "string",
      "required": false,
      "description": "Date de signature par le médecin remplacé (ex: 14/04/2026)"
    },
    "TAUX_CABINET": {
      "type": "string",
      "required": false,
      "description": "Part du cabinet en % ; par défaut 100 moins TAUX_RETROCESSION"
    },
    "CRENEAUX_LISTE": {
      "type": "string",
      "required": false,
      "description": "Créneaux acceptés (texte ou liste) ; par défaut JOURS_REMPLACEMENT"
    },
    "AVERTISSEMENT_PROFIL": {
      "type": "string",
      "required": false,
      "description": "Avertissement explicite ; sinon généré selon MEDECIN_REMPLACANT_THESE (oui/non), avec avertissement si statut absent ou inconnu"
    },
    "IP_SIGNATURE": {
      "type": "string",
      "required": false,
      "description": "Adresse IP lors de la signature électronique (traçabilité)"
    }
  }
}
